              "cat"
              "glass"
              "lang"
              "limit"
              "method"
              "offset"
              "q"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "search"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
